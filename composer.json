{
  "name": "stevenbuehner/sb-churchtools-api",
  "description": "ChurchTools Api Wrapper",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Steven Buehner",
      "email": "buehner@me.com"
    }
  ],
  "require": {
    "php": "^8.4",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "guzzlehttp/guzzle": "^7.3",
    "guzzlehttp/psr7": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "StevenBuehner\\ChurchTools\\": "src/lib",
      "StevenBuehner\\ChurchToolsApi\\": "src/ChurchToolsApi"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "StevenBuehner\\ChurchTools\\Test\\": "src/test/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "friendsofphp/php-cs-fixer": "^3.95"
  }
}
