{
  "defaultPackage": "churchtools-core",
  "packages": [
    {
      "name": "churchtools-auth",
      "composerName": "stevenbuehner/churchtools-auth",
      "description": "ChurchTools API - Authentication (minimal)",
      "pathPrefixes": ["/login", "/whoami", "/csrftoken"],
      "tags": []
    },
    {
      "name": "churchtools-auth-advanced",
      "composerName": "stevenbuehner/churchtools-auth-advanced",
      "description": "ChurchTools API - Authentication advanced",
      "pathPrefixes": [
        "/twofactor",
        "/saml",
        "/oauthclients",
        "/login/totp",
        "/persons/{personId}/settings/twofactor",
        "/persons/{personId}/settings/twofactor/force"
      ],
      "tags": []
    },
    {
      "name": "churchtools-core",
      "composerName": "stevenbuehner/churchtools-core",
      "description": "ChurchTools API - Core endpoints",
      "pathPrefixes": ["/search", "/info", "/masterdata"],
      "tags": ["General", "MasterData"]
    },
    {
      "name": "churchtools-finance",
      "composerName": "stevenbuehner/churchtools-finance",
