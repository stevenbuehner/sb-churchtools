      "pathPrefixes": ["/groups", "/group", "/publicgroups", "/grouphomepages", "/dynamicgroups"],
      "tags": ["Group", "GroupHomepage", "DynamicGroups", "Tag"]
    },
    {
      "name": "churchtools-checkin",
